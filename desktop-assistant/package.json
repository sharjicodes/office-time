{
  "name": "milo-desktop-companion",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight animated desktop companion with user-written Malayalam dialogue.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package:mac": "electron-builder --mac dmg zip",
    "package:mac:universal": "electron-builder --mac dmg zip --universal",
    "package:win": "electron-builder --win nsis zip",
    "package:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.milo.desktop-companion",
    "productName": "Milo Desktop Companion",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "preload.cjs", "cloud-config.json", "renderer/**/*", "assets/**/*"],
    "mac": { "category": "public.app-category.utilities", "target": ["dmg", "zip"] },
    "win": { "target": ["nsis", "zip"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "category": "Utility",
      "target": ["AppImage"]
    }
  }
}
